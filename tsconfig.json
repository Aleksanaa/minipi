{
	"compilerOptions": {
		"target": "ES2023",
		"module": "preserve",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"types": ["node"],
		"typeRoots": ["./.pi-sdk/node_modules/@types"],
		"paths": {
			"@earendil-works/pi-coding-agent": ["./.pi-sdk/dist/index.d.ts"],
			"@earendil-works/pi-tui": ["./.pi-sdk/node_modules/@earendil-works/pi-tui/dist/index.d.ts"],
			"@earendil-works/*": ["./.pi-sdk/node_modules/@earendil-works/*"],
			"typebox": ["./.pi-sdk/node_modules/typebox/build/index.d.mts"]
		}
	},
	"include": ["extensions/**/*.ts"]
}
